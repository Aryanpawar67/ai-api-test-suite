        {
          "name": "POST /v1/summarize - valid key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/summarize",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "summarize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The quick brown fox jumps over the lazy dog near the river bank.\",\n  \"max_words\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('response schema', () => {",
                  "  pm.expect(b).to.have.all.keys('summary', 'model', 'latency_ms', 'request_id');",
                  "  pm.expect(b.summary).to.be.a('string').and.not.empty;",
                  "  pm.expect(b.model).to.be.a('string').and.not.empty;",
                  "  pm.expect(b.latency_ms).to.be.a('number').and.at.least(0);",
                  "});",
                  "pm.test('summary within max_words', () => pm.expect(b.summary.split(/\\s+/).length).to.be.at.most(10));",
                  "pm.test('X-Request-ID matches body', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql(b.request_id));"
                ]
              }
            }
          ]
        },
