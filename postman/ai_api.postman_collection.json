    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON content type', () => pm.response.to.have.header('Content-Type', 'application/json'));",
                  "const b = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(b.status).to.eql('ok'));",
                  "pm.test('mode is mock or live', () => pm.expect(b.mode).to.be.oneOf(['mock', 'live']));",
                  "pm.test('X-Request-ID present', () => pm.response.to.have.header('X-Request-ID'));"
                ]
              }
            }
          ]
        }
      ]
    },
