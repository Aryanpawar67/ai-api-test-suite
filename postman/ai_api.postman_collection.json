    {
      "name": "Rate limit (run last)",
      "item": [
        {
          "name": "POST /v1/summarize - burst until 429",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{rate_limit_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/summarize",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "summarize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The quick brown fox jumps over the lazy dog near the river bank.\",\n  \"max_words\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.info.iteration === 0 && !pm.collectionVariables.get('rl_count')) pm.collectionVariables.set('rl_count', 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get('rl_count') || 0) + 1;",
                  "pm.collectionVariables.set('rl_count', n);",
                  "if (pm.response.code === 429) {",
                  "  pm.collectionVariables.unset('rl_count');",
                  "  pm.test('429 after burst', () => pm.response.to.have.status(429));",
                  "  pm.test('Retry-After header is a positive integer', () => pm.expect(parseInt(pm.response.headers.get('Retry-After'), 10)).to.be.above(0));",
                  "  const b = pm.response.json();",
                  "  pm.test('error schema', () => pm.expect(b.error).to.have.all.keys('code', 'message', 'request_id'));",
                  "  pm.test('error code is rate_limited', () => pm.expect(b.error.code).to.eql('rate_limited'));",
                  "} else if (n < 100) {",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset('rl_count');",
                  "  pm.test('429 after burst', () => { throw new Error('no 429 after 100 requests'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
