# Comma-separated list of accepted API keys (synthetic values only)
API_KEYS=test-key-1,test-key-2
# Only needed when MOCK_LLM=false
ANTHROPIC_API_KEY=
# true = deterministic offline mock LLM (default for tests)
MOCK_LLM=true
# Slack/Discord incoming webhook for monitor alerts
ALERT_WEBHOOK_URL=
# Requests allowed per API key per minute
RATE_LIMIT_PER_MIN=30
# Honor the X-Fault header (testing only, never in production)
ENABLE_FAULTS=false
# Seconds before the API gives up on the LLM
REQUEST_TIMEOUT_SECONDS=10
# How long the "slow" fault delays the mock LLM (should exceed the timeout)
SLOW_FAULT_SECONDS=15
