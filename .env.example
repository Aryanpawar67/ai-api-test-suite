# Comma-separated list of accepted API keys (synthetic values only)
API_KEYS=test-key-1,test-key-2
# Only needed when MOCK_LLM=false
ANTHROPIC_API_KEY=
# true = deterministic offline mock LLM (default for tests)
MOCK_LLM=true
# Slack/Discord incoming webhook for monitor alerts
ALERT_WEBHOOK_URL=
# Requests allowed per API key per minute
RATE_LIMIT_PER_MIN=30
